# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.
PORT=3000

# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers), sans nom de base.
# Atlas fonctionne en replica set : les transactions multidocuments sont disponibles.
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Base utilisée par l'application en développement.
MONGODB_BASE=riz_de_niono
# Base réservée aux tests : elle peut être vidée à tout moment.
MONGODB_BASE_TESTS=riz_de_niono_tests

# Sessions et réinitialisation du mot de passe.
SESSION_DUREE_HEURES=12
REINITIALISATION_DUREE_MINUTES=60
URL_FRONTEND=http://localhost:5173

# Module Email : envoi via Resend (requis au premier envoi).
RESEND_API_KEY=<cle_api_resend>
# Expéditeur sur un domaine vérifié chez Resend, par exemple « Riz de Niono <ne-pas-repondre@domaine> ».
RESEND_FROM=<expediteur>

# Module Média : stockage des pièces jointes chez Cloudinary (requis au premier téléversement).
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<cle_api>
CLOUDINARY_API_SECRET=<secret_api>
# Facultatif : préfixe des dossiers (riz-de-niono par défaut), suivi de l'environnement.
CLOUDINARY_DOSSIER=riz-de-niono

# Comptes de la base de tests (npm run comptes:tests). Choisir des mots de passe d'au moins 8 caractères.
COMPTE_TEST_ADMIN_EMAIL=admin.tests@riz-de-niono.test
COMPTE_TEST_ADMIN_MOT_DE_PASSE=<mot_de_passe_administrateur>
COMPTE_TEST_LIMITE_EMAIL=agent.production.tests@riz-de-niono.test
COMPTE_TEST_LIMITE_MOT_DE_PASSE=<mot_de_passe_agent>
