{
  "name": "riz-de-niono-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST du MVP Riz de Niono",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint src tests",
    "test": "tsx --test --test-concurrency=1 tests/servicesExternes.test.ts tests/authentification.test.ts tests/referentielsProduction.test.ts tests/productionStock.test.ts tests/achats.test.ts tests/transformation.test.ts tests/commercialisation.test.ts tests/inventairesDepenses.test.ts tests/consultations.test.ts",
    "test:services": "tsx --test tests/servicesExternes.test.ts",
    "mongo:verifier": "tsx src/database/verificationMongo.ts",
    "comptes:tests": "tsx src/database/comptesTests.ts",
    "test:auth": "tsx --test tests/authentification.test.ts",
    "test:referentiels": "tsx --test tests/referentielsProduction.test.ts",
    "test:production-stock": "tsx --test tests/productionStock.test.ts",
    "test:achats": "tsx --test tests/achats.test.ts",
    "test:transformation": "tsx --test tests/transformation.test.ts",
    "test:commercialisation": "tsx --test tests/commercialisation.test.ts",
    "test:inventaires-depenses": "tsx --test tests/inventairesDepenses.test.ts",
    "test:consultations": "tsx --test tests/consultations.test.ts",
    "dev:tests": "tsx watch src/server.ts --base-tests"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "mongoose": "^8.24.9",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
